# Copy this file to config.env and edit the paths, then load it before running anything:
#     cp config.env.example config.env
#     source config.env
#
# config.env is git-ignored, so your local paths stay out of version control.

# Root of this repository. Every script and notebook resolves paths from here.
export HNSC_ROOT="$(pwd)"

# CTransPath encoder weights (ctranspath.pth), downloaded from the TransPath repo.
# Only needed for the full pipeline (encoding whole-slide images), not for redrawing figures.
export CTRANSPATH_WEIGHTS="$HNSC_ROOT/models/ctranspath.pth"

# Optional: which GPU(s) the pipeline may use. Only needed for encoding/training.
# export CUDA_VISIBLE_DEVICES=0
